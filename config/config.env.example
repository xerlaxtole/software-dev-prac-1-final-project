NODE_ENV=development
PORT=5000

MONGO_URI=your_mongodb_atlas_connection_string

JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30

# requests per 10 minutes per IP — raise it if Newman runs hit 429
RATE_LIMIT_MAX=100

# used by `npm run seed` to create the admin account
ADMIN_NAME=Admin
ADMIN_TEL=0800000000
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me
